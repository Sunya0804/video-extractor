{
  "name": "video-extractor",
  "productName": "Video Extractor",
  "version": "0.1.3",
  "private": true,
  "description": "개인용 영상 추출기: yt-dlp → 페이지 스캔 → 헤드리스 브라우저 3단계 자동 추출",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "open": "node server.mjs --open",
    "test": "node --test \"tests/*.test.mjs\"",
    "dist:android": "node android/dist.mjs",
    "app": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "release": "node scripts/release.mjs"
  },
  "repository": "github:Sunya0804/video-extractor",
  "main": "desktop/main.mjs",
  "author": "Sunya0804",
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.sunya0804.videoextractor",
    "productName": "Video Extractor",
    "files": [
      "server.mjs",
      "lib/**",
      "public/**",
      "plugins/**",
      "desktop/**",
      "install/icon.*",
      "package.json"
    ],
    "asarUnpack": [
      "plugins/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "install/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "VideoExtractor-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sunya0804",
        "repo": "video-extractor",
        "releaseType": "release"
      }
    ]
  }
}
